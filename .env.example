# Variables de entorno del sistema. Copie este archivo como .env y cambie las claves:
#   cp .env.example .env
# El archivo .env está en .gitignore y nunca se sube al repositorio.

# ---------- Base de datos ----------
MYSQL_DATABASE=pos
MYSQL_USER=pos
MYSQL_PASSWORD=cambie-esta-clave-local
MYSQL_ROOT_PASSWORD=cambie-esta-clave-root

# ---------- Puertos en su máquina ----------
APP_PORT=8080
DB_PORT=3306
